# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Anthropic Console → API keys. Used only by the server, never sent to phones.
ANTHROPIC_API_KEY=sk-ant-...

# Agenda ↔ Google Calendar (optional; README step 5). Server only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Supabase → Project Settings → API Keys → secret key. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# openssl rand -base64 32
AGENDA_TOKEN_KEY=
# Any long random string; Vercel sends it with the daily cron job.
CRON_SECRET=
